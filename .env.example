# Public site URL (used for canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://example.com
# Supabase (server-only values must never use the NEXT_PUBLIC_ prefix)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key   # SECRET. Server only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co  # for admin sign-in (next step)
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Spam protection: any long random string
RATE_LIMIT_SALT=replace-with-random-string
# Email notifications via Resend (optional; notifications are skipped if unset)
RESEND_API_KEY=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Keep the site out of search engines until launch. Remove (or set to false) when going live.
SITE_PRIVATE=true
